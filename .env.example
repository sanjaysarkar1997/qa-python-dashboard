# QA Analytics Dashboard — Environment Configuration
# ====================================================
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#
# ALL variables below are REQUIRED. The app will raise an error
# on startup if any of them are missing.

# ------------------------------------------------------------------
# SERVER SETTINGS
# ------------------------------------------------------------------
# Port the Dash app will listen on
DASHBOARD_PORT=8052

# Set to "true" in development, "false" in production
DASHBOARD_DEBUG=true

# ------------------------------------------------------------------
# REPORTS FOLDER
# ------------------------------------------------------------------
# Absolute path to the folder containing test-summary CSV files.
# The dashboard auto-discovers every *.csv file inside this folder.
REPORTS_FOLDER=/home/sanjay/Desktop/infocus/qa-python-dashboard/reports

# ------------------------------------------------------------------
# EXTERNAL SERVICE URLs
# ------------------------------------------------------------------
# URL for the run-test-server (used by the "Run Tests" button)
RUN_TEST_SERVER_URL=http://localhost:4000

# URL for the Allure report viewer
ALLURE_REPORT_URL=http://localhost:4000/allure-report/index.html
